datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String   @default("MEMBER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdRecords Record[] @relation("RecordCreatedBy")
  updatedRecords Record[] @relation("RecordUpdatedBy")
  auditLogs      AuditLog[]

  @@map("users")
}

model Namespace {
  id          String   @id @default(uuid())
  name        String
  handle      String   @unique
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules Module[]

  @@map("namespaces")
}

model Module {
  id          String   @id @default(uuid())
  namespaceId String
  namespace   Namespace @relation(fields: [namespaceId], references: [id], onDelete: Cascade)
  name        String
  handle      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields          ModuleField[]
  records         Record[]
  automationRules AutomationRule[]

  @@unique([namespaceId, handle])
  @@map("modules")
}

model ModuleField {
  id         String   @id @default(uuid())
  moduleId   String
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name       String
  label      String
  kind       String   @default("String")
  isRequired Boolean  @default(false)
  isMulti    Boolean  @default(false)
  options    String?  // Stores JSON string for dropdown select values or relations
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([moduleId, name])
  @@map("module_fields")
}

model Record {
  id          String    @id @default(uuid())
  moduleId    String
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  values      String    // Dynamic field key-value pairs stored as JSON string
  
  createdById String?
  createdBy   User?     @relation("RecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("RecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([moduleId])
  @@map("records")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  userEmail  String
  action     String   // e.g., 'CREATE_RECORD', 'UPDATE_RECORD', 'DELETE_RECORD', 'UPDATE_ROLE', 'LOGIN'
  entityType String   // e.g., 'RECORD', 'MODULE', 'NAMESPACE', 'USER'
  entityId   String
  details    String?  // JSON string of before/after or metadata
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AutomationRule {
  id                String   @id @default(uuid())
  moduleId          String
  module            Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name              String
  triggerEvent      String   // 'RECORD_CREATED', 'RECORD_UPDATED'
  conditionField    String?  // field name e.g. 'status'
  conditionOperator String?  // 'EQUALS', 'NOT_EQUALS', 'CONTAINS'
  conditionValue    String?  // e.g. 'Won'
  actionType        String   // 'SET_FIELD', 'NOTIFY', 'LOG_EVENT'
  actionPayload     String   // JSON string with parameters e.g. { "targetField": "priority", "value": "High" }
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([moduleId])
  @@map("automation_rules")
}
